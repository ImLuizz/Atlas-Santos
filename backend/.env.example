# ==============================================================================
# Atlas Santos — Backend Environment Configuration Example
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
DEBUG=true
APP_NAME="Atlas Santos API"
APP_VERSION="0.1.0"
PORT=8000
HOST="0.0.0.0"

# Reserved for the future session implementation. Set secrets in Railway.
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Database Persistence (PostgreSQL with async psycopg driver)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/atlas_santos"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Storage — Railway Buckets / S3-compatible Private Object Storage
STORAGE_BUCKET_NAME="atlas-santos-media-dev"
# STORAGE_ENDPOINT_URL=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=

# Operational defaults. Only the default photo quota is specified by the project.
DEFAULT_PHOTO_QUOTA=20
MAX_UPLOAD_SIZE_MB=15
RESERVATION_TTL_MINUTES=30
PRESIGNED_UPLOAD_TTL_MINUTES=10
PRESIGNED_DOWNLOAD_TTL_MINUTES=5
JOB_TIMEOUT_SECONDS=300

