# ==============================================================================
# Atlas Santos — Backend Environment Configuration Example
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
DEBUG=true
APP_NAME="Atlas Santos API"
APP_VERSION="0.1.0"
PORT=8000
HOST="0.0.0.0"

# Security & Sessions (Must be overridden in production with a 32+ character random secret)
SECRET_KEY="replace-this-in-production-with-a-cryptographically-secure-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Database Persistence (PostgreSQL with async psycopg driver)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/atlas_santos"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Storage — Railway Buckets / S3-compatible Private Object Storage
STORAGE_BUCKET_NAME="atlas-santos-media-dev"
STORAGE_ENDPOINT_URL="https://s3.us-east-1.amazonaws.com"
STORAGE_ACCESS_KEY_ID="mock-storage-key"
STORAGE_SECRET_ACCESS_KEY="mock-storage-secret"
STORAGE_REGION="us-east-1"

# Operational Quotas and Validation Parameters (Propostas - Seção 9)
DEFAULT_PHOTO_QUOTA=20
MAX_UPLOAD_SIZE_MB=15
RESERVATION_TTL_MINUTES=30
PRESIGNED_UPLOAD_TTL_MINUTES=10
PRESIGNED_DOWNLOAD_TTL_MINUTES=5
MAX_DESCRIPTION_CHARS=600
MAX_REFLECTION_CHARS=1200

