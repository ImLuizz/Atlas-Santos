# ==============================================================================
# Atlas Santos — Frontend Environment Configuration Example
# ==============================================================================

# Backend API base URL
VITE_API_BASE_URL="http://localhost:8000"

# Application Metadata
VITE_APP_TITLE="Atlas Santos"
VITE_APP_VERSION="0.1.0"

# Cartography Map Defaults (Santos, SP Coordinates)
VITE_MAP_DEFAULT_LAT="-23.9682"
VITE_MAP_DEFAULT_LNG="-46.3322"
VITE_MAP_DEFAULT_ZOOM="16"
# Token público de visualização (pk.), restrito aos domínios do Atlas no Mapbox.
# Vite publica os valores VITE_* no navegador. Credenciais privadas ficam na API.
VITE_MAPBOX_ACCESS_TOKEN=""

