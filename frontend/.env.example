# ==============================================================================
# Atlas Santos — Frontend Environment Configuration Example
# ==============================================================================

# Backend API base URL
VITE_API_BASE_URL="http://localhost:8000"

# Application Metadata
VITE_APP_TITLE="Atlas Santos"
VITE_APP_VERSION="0.1.0"

# Cartography Map Defaults (Santos, SP Coordinates)
VITE_MAP_DEFAULT_LAT="-23.9608"
VITE_MAP_DEFAULT_LNG="-46.3336"
VITE_MAP_DEFAULT_ZOOM="13"
VITE_MAP_TILE_LAYER_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"

